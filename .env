# ===== CORE BOT IDENTITY =====
BOT_NAME="Sung"
CREATOR="Ayo_codes"
BOT_VERSION="1.0.0"
NODE_ENV="production"  # development/production/test

# ===== WHATSAPP SESSION CONFIGURATION =====
SESSION_NAME="SungSession_PROD"
SESSION_ENCRYPTION_KEY="your_secure_encryption_key_here"  # For session data encryption
SESSION_SAVE_INTERVAL="15"  # minutes
RESTART_ON_CRASH="true"
MAX_CRASH_RETRIES="3"

# ===== ADMINISTRATION =====
PRIMARY_ADMIN="+2349159180375"  # International format required
SECONDARY_ADMIN="+2349158468858"
DEVELOPER_CONTACT="+2347038517111"
ADMIN_COMMAND_PREFIX="!"  # Prefix for admin commands

# ===== DATABASE CONFIGURATION =====
MONGODB_URI="mongodb+srv://sungbot-admin:${DB_PASSWORD}@sungbot-cluster.u8dimxc.mongodb.net/sungbot?retryWrites=true&w=majority"
DB_BACKUP_INTERVAL="24"  # hours
DB_QUERY_TIMEOUT="5000"  # milliseconds

# ===== SECURITY SETTINGS =====
AUTHENTICATION_TIMEOUT="300"  # seconds
MAX_LOGIN_ATTEMPTS="5"
IP_WHITELIST=("192.168.1.1" "10.0.0.2")  # Allowed IPs
ENABLE_2FA="true"

# ===== API CONFIGURATION =====
# Movie API (TMDb)
TMDB_API_KEY="83dde0f2bd4c0774ccffe4ba623dbae9"
TMDB_API_TIMEOUT="5000"  # ms

# Spotify API (Optional)
SPOTIFY_CLIENT_ID="your_client_id"
SPOTIFY_CLIENT_SECRET="your_client_secret"
SPOTIFY_REDIRECT_URI="http://localhost:3000/callback"

# ===== MEDIA SETTINGS =====
MAX_MEDIA_SIZE="50"  # MB
ALLOWED_MEDIA_TYPES=("image/jpeg" "image/png" "video/mp4")
MEDIA_DOWNLOAD_TIMEOUT="30000"  # milliseconds

# ===== NOTIFICATION SYSTEM =====
# Email Configuration (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="officialayomide19@gmail.com"
SMTP_PASSWORD="${EMAIL_APP_PASSWORD}"  # Use app-specific password
SMTP_FROM="Sung Bot <no-reply@sungbot.com>"
SMTP_SECURE="true"  # TLS

# WhatsApp Notifications
ENABLE_STATUS_NOTIFICATIONS="true"
ENABLE_ERROR_NOTIFICATIONS="true"

# ===== PERFORMANCE SETTINGS =====
MAX_CONCURRENT_PROCESSES="10"
MESSAGE_QUEUE_LIMIT="50"
CACHE_TTL="3600"  # seconds (1 hour)
MEMORY_LIMIT="512"  # MB

# ===== FEATURE FLAGS =====
FEATURES=(
  ["AI_ASSISTANT"]="true"
  ["MEDIA_DOWNLOAD"]="true"
  ["GROUP_MANAGEMENT"]="true"
  ["USAGE_ANALYTICS"]="false"
)

# ===== MONITORING & LOGGING =====
LOG_LEVEL="info"  # error/warn/info/debug
LOG_RETENTION_DAYS="7"
HEALTH_CHECK_INTERVAL="60"  # seconds
CRASH_REPORTING="true"

# ===== ADVANCED CONFIGURATION =====
# Proxy Settings (Optional)
PROXY_ENABLED="false"
PROXY_URL="socks5://user:pass@host:port"

# Localization
DEFAULT_LANGUAGE="en"
SUPPORTED_LANGUAGES=("en" "es" "fr")

# External Services
TRANSLATION_API_KEY=""  # Google Translate API
WEATHER_API_KEY="4f93f92bc652a56bf4d616d0a9196e41"  # OpenWeatherMap API

TEST_NUMBER="+2347038517111" # Your phone number with country code
