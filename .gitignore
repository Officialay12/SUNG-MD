# Public directory exceptions
public/downloads/temp/*
public/downloads/movies/cached/*
public/downloads/songs/cached/*
!public/downloads/movies/metadata.json
!public/downloads/songs/metadata.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development
.env.test
.env.production

# Dependency directories
node_modules/
dist/

# Cache
.cache/
.temp/
session/  # If your bot stores session data (e.g., for whatsapp-web.js)

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build/compiled files
*.exe
*.bin
*.apk
*.dll
*.so
*.out
*.pyc
__pycache__/

# Misc
*.bak
*.tmp
*.pid
*.seed
*.pid.lock